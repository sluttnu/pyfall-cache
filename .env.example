APP_ENV=production
APP_PORT=8080

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://scryfall:scryfall@postgres:5432/scryfall

SCRYFALL_API_BASE=https://api.scryfall.com
